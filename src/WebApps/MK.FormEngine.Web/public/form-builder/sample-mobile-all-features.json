      "default_value": null,
      "required": true,
      "hidden": false,
      "disabled": false,
      "min_length": 2,
      "max_length": 100,
      "pattern": {
        "regex": "^[A-Za-z\\s]{2,100}$",
        "description": "Letters and spaces only (2 to 100 characters)"
      },
      "visible_conditions": {
        "match": "all",
        "conditions": [],
        "preserve_data": false
      },
      "required_conditions": {
        "match": "all",
        "conditions": []
      }
    },
    {
